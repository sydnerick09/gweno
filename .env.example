# Copy this file to ".env" and fill in your keys. Everything is REAL — a feature
# stays disabled (returns a clear "not available yet" error) until its keys exist.
# M-Pesa keys: https://developer.safaricom.co.ke (create an app).
#
# ⭐ You ONLY need the CORE keys below. The three callback URLs are OPTIONAL — the app
#    auto-points Safaricom at your live domain (…/api/mpesa/stk-callback, /result,
#    /timeout). Set them only if you use a custom domain/tunnel and want to override.
#    On Safaricom's portal, register these same live URLs for your app.

MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=               # CORE
MPESA_CONSUMER_SECRET=            # CORE

# ---- Deposits: STK Push (Lipa na M-Pesa Online) ----
MPESA_STK_SHORTCODE=              # CORE — Lipa na M-Pesa shortcode (sandbox: 174379)
MPESA_PASSKEY=                    # CORE — Lipa na M-Pesa Online passkey
MPESA_STK_CALLBACK_URL=          # optional — auto-derived to https://YOUR-DOMAIN/api/mpesa/stk-callback

# ---- Withdrawals: B2C ----
MPESA_SHORTCODE=                  # CORE — your B2C shortcode (sandbox: 600000-series)
MPESA_INITIATOR_NAME=            # CORE — e.g. testapi
MPESA_SECURITY_CREDENTIAL=       # CORE — initiator password encrypted with Safaricom's public cert
MPESA_COMMAND_ID=BusinessPayment  # BusinessPayment | SalaryPayment | PromotionPayment
MPESA_RESULT_URL=                # optional — auto-derived to https://YOUR-DOMAIN/api/mpesa/result
MPESA_TIMEOUT_URL=               # optional — auto-derived to https://YOUR-DOMAIN/api/mpesa/timeout

# ---- Supabase (database) ----
# App persists to Supabase Postgres when DATABASE_URL is set (else local file).
# Copy the URI from: Supabase Dashboard -> Project Settings -> Database ->
# Connection string -> URI, and replace [YOUR-PASSWORD] with your DB password.
# If the direct host fails on your network, use the "Session pooler" URI instead.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=                # Project Settings -> API -> anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=        # Project Settings -> API -> service_role (secret)

# ---- Admin panel (separate login — NOT a client account) ----
# The only credentials that unlock /admin.html. Choose your own.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# ---- Wallet ----
FX_KES_PER_USD=129                # KES per USD used for the balance conversion

# ---- Investment funding (USD) ----
# Investments are paid for via the method the investor picks. Each provider stays
# disabled (returns "add your keys") until its keys are set here. M-Pesa reuses the
# keys above (STK Push). PUBLIC_URL is where providers send the browser back to.
PUBLIC_URL=                       # e.g. https://your-domain (blank = auto-detect from the request)
# Stripe — also powers the "Card" method.  https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=                # sk_live_... or sk_test_...
STRIPE_PUBLISHABLE_KEY=           # pk_... (not required for hosted Checkout, kept for future use)
# PayPal —  https://developer.paypal.com/dashboard/applications
PAYPAL_ENV=sandbox                # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Paystack —  https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=              # sk_live_... or sk_test_...
PAYSTACK_PUBLIC_KEY=              # pk_... (optional)
PAYSTACK_CURRENCY=KES             # your Paystack account's settlement currency (KES/NGN/GHS/ZAR/USD)
                                  # USD invest amounts are converted to this using FX_KES_PER_USD (KES accounts)

# ---- Bank transfer deposits ----
# Your receiving bank account. Shown to users BEFORE a bank-transfer deposit so they
# know where to send the money; the deposit is recorded pending until you confirm it.
# Bank transfer stays hidden until at least NAME + ACCOUNT_NUMBER are filled in.
DEPOSIT_BANK_NAME=                # e.g. Equity Bank Kenya
DEPOSIT_BANK_ACCOUNT_NAME=        # the account holder / business name
DEPOSIT_BANK_ACCOUNT_NUMBER=      # your account number
DEPOSIT_BANK_BRANCH=              # (optional) branch name/code
DEPOSIT_BANK_SWIFT=              # (optional) SWIFT/BIC for international transfers
DEPOSIT_BANK_INSTRUCTIONS=        # (optional) e.g. "Use your username as the reference"

# ---- Social login (real OAuth). Redirect URI to register with each provider:
#      https://YOUR-DOMAIN/api/oauth/<provider>/callback
# Google:   https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps (Facebook Login product)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Apple:    https://developer.apple.com (Service ID + Sign in with Apple key .p8)
APPLE_CLIENT_ID=                  # your Services ID (e.g. app.gweno.web)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                # contents of the .p8 (use \n for newlines, or one line)

# ---- Email (real, via SMTP) — password resets + magic sign-in links + support inbox ----
SMTP_HOST=                        # e.g. smtp.gmail.com / smtp.sendgrid.net
SMTP_PORT=587                     # 587 (STARTTLS) or 465 (TLS)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gweno <no-reply@gweno.app>
SUPPORT_EMAIL=                    # where /support messages are delivered

# ---- CAPTCHA (Cloudflare Turnstile) — bot protection on sign-up ----
# Free keys: https://dash.cloudflare.com -> Turnstile -> Add site (add your domain).
# When BOTH are set the "I'm not a robot" widget shows on sign-up and is verified
# server-side. Leave blank to disable (sign-up still works without the check).
TURNSTILE_SITE_KEY=               # public site key (safe to expose in the page)
TURNSTILE_SECRET=                 # secret key (server-side verification only)

# Optional: make a specific account the admin (else the first sign-up is admin)
# ADMIN_EMAIL=you@example.com
