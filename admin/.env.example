# Gweno ADMIN — standalone app. Deploy as its OWN Vercel project.
# It shares the SAME Supabase database as the main site (same DATABASE_URL).

# ---- Database (must be the SAME value as the main Gweno site) ----
# Use the Supabase SESSION POOLER URI (…pooler.supabase.com:5432) — IPv4-friendly for serverless.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ---- Admin login (choose strong values; this is the only way in) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# ---- Display ----
FX_KES_PER_USD=129
